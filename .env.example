# Copy to .env and fill in. .env is ignored by git. Never commit real keys or addresses.

# Google Gemini API key (server only). Get one in Google AI Studio.
GEMINI_API_KEY=
# Optional backup keys, tried in order when the key above reaches its limit or is refused. Each one
# must come from a different Google Cloud project: the free limit is counted per project, not per key.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Model ID. Stable ID verified 2026-11-16.
GEMINI_MODEL=gemini-3.1-flash-lite
# Sampling temperature for the field reader. Default 0. Write "off" to stop sending it, in case a
# later model rejects the parameter.
GEMINI_TEMPERATURE=0

# Contact address sent to Crossref (query parameter and User-Agent) to join its "polite pool".
# Without it Crossref allows 5 requests per second and 1 at a time; with it, 10 per second and 3 at a time.
CROSSREF_MAILTO=

# Optional free OpenAlex key (sent as a bearer token). Without a key the free budget is $0.10 per day
# shared by everyone on your IP address; with a free key it is $1 per day. Activate the key by email first.
OPENALEX_API_KEY=

# Garuda (garuda.kemdiktisaintek.go.id), the national index of Indonesian journals, is asked after Crossref
# and OpenAlex for a journal article they do not hold. It has no API, so its search page is read as HTML.
# Set to false to stop using it (for example if its page layout changes and the reader is not updated yet).
GARUDA_ENABLED=true

# Rate limit for /api/check per IP address. Defaults: 10 checks per 10 minutes.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=10

# Request limits, enforced on the server. Over the limit is rejected, never truncated.
MAX_REFERENCES=40
MAX_REFERENCE_CHARS=600

# Experiment options (system, ablation) on /api/check. Must be false in production.
ENABLE_EXPERIMENT_MODES=false

# Evaluation harness: directory for the retrieval file cache (record once, replay for free).
# Leave empty in production. Set RETRIEVAL_CACHE_REPLAY_ONLY=true to forbid network use.
RETRIEVAL_CACHE_DIR=
RETRIEVAL_CACHE_REPLAY_ONLY=false

# Evaluation cost report: USD per million tokens, read from Google's current price list.
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=

# Public base URL of the deployed site.
PUBLIC_SITE_URL=http://localhost:8787

# Server port. Most hosts set this for you.
PORT=8787
# Number of proxy hops to trust when reading the client IP for the rate limit.
# Default: 1 in production (one reverse proxy in front), 0 otherwise.
TRUST_PROXY=
# Log level: debug, info, warn, error. Logs never contain reference text.
LOG_LEVEL=info
# Folder of the built web app. Default: apps/web/dist when it exists.
STATIC_DIR=
# Evaluation summary shown on the Evaluation page. Default: eval/results/summary.json.
# A missing file, or a summary made from template data, shows the empty state.
EVALUATION_SUMMARY=
