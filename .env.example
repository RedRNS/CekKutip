# Copy to .env and fill in. .env is ignored by git. Never commit real keys or addresses.

# Google Gemini API key (server only). Get one in Google AI Studio.
GEMINI_API_KEY=
# Model ID. Stable ID verified 2026-11-16.
GEMINI_MODEL=gemini-3.1-flash-lite

# Contact address sent to Crossref (query parameter and User-Agent) to join its "polite pool".
# Without it Crossref allows 5 requests per second and 1 at a time; with it, 10 per second and 3 at a time.
CROSSREF_MAILTO=

# Optional free OpenAlex key (sent as a bearer token). Without a key the free budget is $0.10 per day
# shared by everyone on your IP address; with a free key it is $1 per day. Activate the key by email first.
OPENALEX_API_KEY=

# Rate limit for /api/check per IP address. Defaults: 10 checks per 10 minutes.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=10

# Request limits, enforced on the server. Over the limit is rejected, never truncated.
MAX_REFERENCES=40
MAX_REFERENCE_CHARS=600

# Experiment options (system, ablation) on /api/check. Must be false in production.
ENABLE_EXPERIMENT_MODES=false

# Evaluation harness: directory for the retrieval file cache (record once, replay for free).
# Leave empty in production. Set RETRIEVAL_CACHE_REPLAY_ONLY=true to forbid network use.
RETRIEVAL_CACHE_DIR=
RETRIEVAL_CACHE_REPLAY_ONLY=false

# Evaluation cost report: USD per million tokens, read from Google's current price list.
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=

# Public base URL of the deployed site.
PUBLIC_SITE_URL=http://localhost:8787
