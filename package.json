{
  "name": "cekkutip",
  "version": "0.1.0",
  "private": true,
  "description": "Reference list checker for Indonesian students. Verdicts come from fixed rules over Crossref and OpenAlex data.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "echo 'dev scripts arrive in M3/M4'",
    "build": "npm run build -w @cekkutip/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:live": "tsx --env-file=.env scripts/smoke-live.ts",
    "fixtures:record": "tsx scripts/record-fixtures.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
